{
  "name": "samjuk/demo-package-phpstan-magento",
  "description": "Fixture: a module with its own tooling (PHPStan with bitexpert/phpstan-magento, PHPCS from samjuk/dev-standards), using a generated factory",
  "type": "magento2-module",
  "license": "MIT",
  "require": {
    "magento/framework": "^103.0"
  },
  "require-dev": {
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "magento/magento-coding-standard": "^41.0",
    "samjuk/dev-standards": "^1.0"
  },
  "repositories": {
    "mage-os": {
      "type": "composer",
      "url": "https://mirror.mage-os.org/"
    }
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "SamJUK\\DemoPhpstanMagento\\": ""
    }
  },
  "config": {
    "allow-plugins": {
      "magento/composer-dependency-version-audit-plugin": false,
      "phpstan/extension-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
